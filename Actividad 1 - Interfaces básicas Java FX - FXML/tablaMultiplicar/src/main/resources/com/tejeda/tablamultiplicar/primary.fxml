<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TextArea?> 

<VBox xmlns:fx="http://javafx.com/fxml/1" alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" fx:controller="com.tejeda.tablamultiplicar.PrimaryController">
   <children>
      <Label text="Tabla de multiplicar de " />
      <TextField fx:id="num"/>
      <Button fx:id="calucular" text="Calcular" onAction="#calcular"/>
      <Button fx:id="limpiar" text="Limpiar" onAction="#limpiar"/>  
      <TextArea fx:id="multVista"/> 
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
