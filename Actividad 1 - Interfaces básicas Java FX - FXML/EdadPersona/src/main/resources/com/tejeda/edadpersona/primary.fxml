<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tejeda.edadpersona.PrimaryController">
   <children>
      <Label text="Calcular la edad" />
      <DatePicker fx:id="edad"/>
      <Button fx:id="calcular" onAction="#calcularEdad" text="Calcular" />
      <Button fx:id="limpiar" onAction="#limpiarFecha" text="Limpiar" />
      <Label fx:id="mostrarEdad" text=" " />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
