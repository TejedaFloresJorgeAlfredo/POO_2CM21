<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.TextField?>
<VBox xmlns:fx="http://javafx.com/fxml/1" alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" fx:controller="com.tejeda.controlgastos.PrimaryController">
   <children>
      <Label text="Alimentacion" />
      <TextField fx:id="alim" />
      <Label text="Refrigerios" />
      <TextField fx:id="refri" />
      <Label text="Transporte" />
      <TextField fx:id="trans" />
      <Label text="Telefonia" />
      <TextField fx:id="tel" />
      <Label text="Otros" />
      <TextField fx:id="otro" />
      <Label text="Estadisticas" />
      <Label text="total semanal" />
      <TextField fx:id="total" />
      <Label text="gasto mas alto" />
      <TextField fx:id="gastoAlto" />
      
      <Button fx:id="calEstadisticas" text="Calcular estadisticas" onAction="#switchToSecondary"/>
      <Button fx:id="limpiar" text="Limpiar" onAction="#limpiar"/>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
